# Firebase web app config (Firebase Console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Comma-separated allowlist. Empty = any Google account (dev only).
# Example: alice@gmail.com,bob@example.com
VITE_ALLOWED_EMAILS=kimth0930@gmail.com

# Admins who can edit Firestore invite list (appConfig/invites).
# Defaults to the first VITE_ALLOWED_EMAILS entry when empty.
# Example: alice@gmail.com
VITE_ADMIN_EMAILS=kimth0930@gmail.com

# Firestore rules tip (Console → Firestore → Rules):
# match /appConfig/invites {
#   allow read: if request.auth != null;
#   allow write: if request.auth != null
#     && request.auth.token.email in resource.data.admins;
# }
# First write: allow admin emails from VITE_ADMIN_EMAILS to create the doc.
